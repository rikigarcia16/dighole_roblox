{
  "name": "TheHoleNeverEnds",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 40,
        "CameraMinZoomDistance": 0.5
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FallenPartsDestroyHeight": -49000,
        "StreamingEnabled": true
      },
      "Terrain": {
        "$properties": {
          "Decoration": false
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "Brightness": 2.4,
        "ClockTime": 14.5,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.4
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    }
  }
}
